{
  "name": "cv-job-assistant-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: analyze job postings against your CV and track applications in Notion.",
  "scripts": {
    "dev": "vite build --watch --mode development",
