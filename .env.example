# Copy to .env.local for local dev, and set these in the Vercel project settings.

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Notion integration (internal integration token, starts with "ntn_" / "secret_")
NOTION_TOKEN=

# Shared secret the extension sends in the `x-app-secret` header on every request.
# Generate any long random string; paste the same value into the extension options.
APP_SHARED_SECRET=

# Redis (Upstash, via the Vercel Marketplace "Redis" integration) — injected
# automatically once the store is connected. Needed for storing the Notion
# database id. Upstash's own env names (UPSTASH_REDIS_REST_URL/TOKEN) also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
